#!/bin/sh
# Strip "Co-Authored-By: Claude ..." trailers from the commit message.
# Fires on every commit (manual or tool-generated). Argument $1 is the
# path to the file holding the proposed commit message.
#
# Only trailers in the final paragraph (the trailer block at the end of the
# message) are removed -- a line mentioning the trailer in the body prose is
# left untouched. Human co-authors and other trailers are preserved.
#
# Enable in a fresh clone with:  git config core.hooksPath .githooks

msg_file="$1"
tmp="$msg_file.tmp"

# 1. Trim trailing blank lines so the trailer block is the true last paragraph.
# 2. (awk) drop "Co-Authored-By: Claude" lines only in that final paragraph:
#    buffer lines; a blank line flushes the pending paragraph verbatim (it is
#    not the last one); only the final buffered paragraph is filtered.
# 3. Trim trailing blank lines again in case the filter emptied the block.
trim='
:a
/^\n*$/{$d;N;ba
}'
sed -e "$trim" "$msg_file" \
	| awk '
		function flush(filter,   i) {
			for (i = 1; i <= n; i++) {
				if (filter && buf[i] ~ /^[Cc]o-[Aa]uthored-[Bb]y:[[:space:]]*Claude/)
					continue
				print buf[i]
			}
			n = 0
		}
		/^[[:space:]]*$/ { flush(0); print; next }
		{ buf[++n] = $0 }
		END { flush(1) }
	' \
	| sed -e "$trim" > "$tmp"
mv "$tmp" "$msg_file"
